NODE_ENV=production
HOST=0.0.0.0
PORT=8787
LEDGER_DB_PATH=/data/shared-ledger.sqlite

# Public HTTPS hostname used by Caddy/docker-compose.
APP_DOMAIN=api.example.com
ADMIN_DOMAIN=admin.example.com
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-long-random-initial-password

# Required for /admin and /api/v1/admin/* (24+ chars).
ADMIN_TOKEN=replace-with-a-long-random-token

# App update policy.
APP_UPDATE_ANDROID_LATEST_VERSION=1.0.0
APP_UPDATE_ANDROID_MINIMUM_VERSION=1.0.0
APP_UPDATE_ANDROID_STORE_URL=https://example.com/android
APP_UPDATE_IOS_LATEST_VERSION=1.0.0
APP_UPDATE_IOS_MINIMUM_VERSION=1.0.0
APP_UPDATE_IOS_STORE_URL=https://example.com/ios

# FCM HTTP v1 service-account values.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Apple Push Notification service token values.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=com.algive.jizhangApp
APNS_ENV=production

# Optional custom vendor push gateway.
VENDOR_PUSH_URL=
VENDOR_PUSH_TOKEN=

# Retention. Shared sync tombstones are intentionally never pruned without
# a safe per-device acknowledgement watermark.
DIAGNOSTIC_RETENTION_DAYS=30
ANALYTICS_RETENTION_DAYS=180
SUPPORT_RESOLVED_RETENTION_DAYS=365
ADMIN_AUDIT_RETENTION_DAYS=365
PUSH_OUTBOX_RETENTION_DAYS=30
SYNC_TOMBSTONE_RETENTION_DAYS=90

BACKUP_DIR=/backups
BACKUP_KEEP=14

BACKUP_INTERVAL_SECONDS=86400

# Optional generic JSON webhook for health/backup alerts.
ALERT_WEBHOOK_URL=
MONITOR_READY_URL=http://app:8787/ready
MONITOR_INTERVAL_SECONDS=60
MONITOR_FAILURE_THRESHOLD=3
MONITOR_ALERT_COOLDOWN_SECONDS=1800

# Production default. Local previews may explicitly enable testing access.
ALL_FEATURES_FREE_FOR_TESTING=false

# Market provider: normalized (existing gateway) or twelvedata (official API).
# Keys stay on the server. Basic access is for evaluation/personal use;
# public app display requires the provider's applicable business rights.
MARKET_DATA_PROVIDER=normalized
TWELVE_DATA_API_KEY=

# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Preserve separately from database backups; loss prevents reading encrypted keys.
INTEGRATION_ENCRYPTION_KEY=
AI_ENDPOINT_ALLOWLIST=api.deepseek.com,api.openai.com
PAYMENT_RECONCILE_ENABLED=true
# Payment and Tencent credentials can be configured in the console after setting the key.
WECHAT_REFUND_NOTIFY_URL=https://api.example.com/api/v1/payments/wechat/refund-notify
TENCENT_ASR_SECRET_ID=
TENCENT_ASR_SECRET_KEY=
TENCENT_ASR_ENGINE=16k_zh

# Controlled deployment integration. Image repository must match exactly.
BACKEND_VERSION=1.0.0
BACKEND_IMAGE_REPOSITORY=
BACKEND_DEPLOY_URL=
BACKEND_DEPLOY_SECRET=
