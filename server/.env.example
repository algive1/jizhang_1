NODE_ENV=production
HOST=0.0.0.0
PORT=8787
LEDGER_DB_PATH=/data/shared-ledger.sqlite

# Public HTTPS hostname used by Caddy/docker-compose.
APP_DOMAIN=api.example.com

# Required for /admin and /api/v1/admin/* (24+ chars).
ADMIN_TOKEN=replace-with-a-long-random-token

# App update policy.
APP_UPDATE_ANDROID_LATEST_VERSION=1.0.0
APP_UPDATE_ANDROID_MINIMUM_VERSION=1.0.0
APP_UPDATE_ANDROID_STORE_URL=https://example.com/android
APP_UPDATE_IOS_LATEST_VERSION=1.0.0
APP_UPDATE_IOS_MINIMUM_VERSION=1.0.0
APP_UPDATE_IOS_STORE_URL=https://example.com/ios

# FCM HTTP v1 service-account values.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Apple Push Notification service token values.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=com.algive.jizhangApp
APNS_ENV=production

# Optional custom vendor push gateway.
VENDOR_PUSH_URL=
VENDOR_PUSH_TOKEN=

# Retention. Shared sync tombstones are intentionally never pruned without
# a safe per-device acknowledgement watermark.
DIAGNOSTIC_RETENTION_DAYS=30
ANALYTICS_RETENTION_DAYS=180
SUPPORT_RESOLVED_RETENTION_DAYS=365
ADMIN_AUDIT_RETENTION_DAYS=365
PUSH_OUTBOX_RETENTION_DAYS=30
SYNC_TOMBSTONE_RETENTION_DAYS=90

BACKUP_DIR=/backups
BACKUP_KEEP=14

BACKUP_INTERVAL_SECONDS=86400

# Optional generic JSON webhook for health/backup alerts.
ALERT_WEBHOOK_URL=
MONITOR_READY_URL=http://app:8787/ready
MONITOR_INTERVAL_SECONDS=60
MONITOR_FAILURE_THRESHOLD=3
MONITOR_ALERT_COOLDOWN_SECONDS=1800

# Temporary product-testing switch. Set false before public launch.
ALL_FEATURES_FREE_FOR_TESTING=true
