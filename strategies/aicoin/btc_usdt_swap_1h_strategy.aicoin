// @version=2
// BTC-USDT-SWAP 1H 趋势策略（AiCoin Script v2）
// 使用要求：只加载在 OKX BTCUSDT 永续 1H 标准K线上，并设置为每根K线收盘执行。
// 风险提示：本脚本只实现用户给定的趋势出入场逻辑，不包含硬止损、止盈或仓位风控。

// === 参数 ===
ema_fast = 12
ema_slow = 26
macd_fast = 12
macd_slow = 26
macd_signal = 9
rsi_fast = 7
rsi_slow = 21
vol_ma_length = 20
vol_ratio = 1.3
order_amount = 1

// === 指标计算 ===
ma_f = ema(close, ema_fast)
ma_s = ema(close, ema_slow)
[dif, dea, macd_hist] = macd(close, macd_fast, macd_slow, macd_signal, 'EMA', 'EMA')
rsi_f = rsi(close, rsi_fast)
rsi_s = rsi(close, rsi_slow)
// 按原始定义：均量包含当前柱与前19根柱。
vol_ma = ma(volume, vol_ma_length)
ready = !na(ma_s) && !na(macd_hist[1]) && !na(rsi_s) && !na(vol_ma)

// === 独立条件 ===
ema_bullish = ma_f > ma_s
ema_bearish = ma_f < ma_s
ema_golden_cross = crossup(ma_f, ma_s)
ema_dead_cross = crossdown(ma_f, ma_s)

macd_bullish = dif > dea && macd_hist > macd_hist[1]
macd_bearish = dif < dea && macd_hist < macd_hist[1]

// 这是同一1H周期上的双长度RSI共振，不是真正的多时间周期。
rsi_bullish = rsi_f > rsi_s && rsi_f > 50
rsi_bearish = rsi_f < rsi_s && rsi_f < 50

volume_confirm = volume > vol_ma * vol_ratio
not_chop = rsi_f < 40 || rsi_f > 60

// === 严格入场与退出条件 ===
long_signal = ready && ema_bullish && macd_bullish && rsi_bullish && volume_confirm && not_chop
short_signal = ready && ema_bearish && macd_bearish && rsi_bearish && volume_confirm && not_chop
long_exit_signal = ready && (ema_dead_cross || rsi_f < 50)
short_exit_signal = ready && (ema_golden_cross || rsi_f > 50)

// === 单一仓位状态机 ===
// -1=脚本认为持空，0=空仓，1=脚本认为持多。
// 默认采用保守模式：退出当根不反手，下一根仍满足严格信号才重新入场。
var position_state = 0

exit_long_event = position_state == 1 && long_exit_signal
exit_short_event = position_state == -1 && short_exit_signal
enter_long_event = position_state == 0 && long_signal && !short_signal
enter_short_event = position_state == 0 && short_signal && !long_signal

// === 交易执行：先固定事件并下单，最后才更新状态 ===
exitLongAmount(exit_long_event, id='EL', price='market', amount=order_amount)
exitShortAmount(exit_short_event, id='ES', price='market', amount=order_amount)
enterLongAmount(enter_long_event, id='L1', price='market', amount=order_amount)
enterShortAmount(enter_short_event, id='S1', price='market', amount=order_amount)

// 绘图和预警复用同一批一次性事件，避免持仓期间重复标注/报警。
plot(ma_f, title='EMA12快线', color='#FF6B6B', lineWidth=2)
plot(ma_s, title='EMA26慢线', color='#4ECDC4', lineWidth=2)
plotText(enter_long_event, title='开多', text='做多', refSeries=low, bgColor='#00C853', color='white', placement='bottom')
plotText(enter_short_event, title='开空', text='做空', refSeries=high, bgColor='#FF1744', color='white', placement='top')
plotText(exit_long_event, title='平多', text='平多', refSeries=high, bgColor='#FF9100', color='white', placement='top')
plotText(exit_short_event, title='平空', text='平空', refSeries=low, bgColor='#00B0FF', color='white', placement='bottom')

alertcondition(enter_long_event, title='做多信号', direction='buy')
alertcondition(enter_short_event, title='做空信号', direction='sell')
alertcondition(exit_long_event, title='平多信号', direction='sell')
alertcondition(exit_short_event, title='平空信号', direction='buy')

if (exit_long_event || exit_short_event) {
    position_state := 0
} else if (enter_long_event) {
    position_state := 1
} else if (enter_short_event) {
    position_state := -1
}
