# 源码快照与打包产物（scripts/package_source.sh 生成，可随时重建）
# 例：jizhang_app_source_20260918-2125.zip 与解包目录 jizhang_app/
/jizhang_app/
/jizhang_app_source_*.zip

# 本地构建的安装包输出：dist/ 不随仓库分发
# APK 由 ./scripts/build_install_android.sh 生成到本地 dist/，需要分发时上传 GitHub Release
/dist/
