    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M7,2h10a1,1 0 0 1 1,1v18.2a0.6,0.6 0 0 1 -0.94,0.5L14.5,20l-2.5,1.7a0.6,0.6 0 0 1 -0.72,0L8.5,20l-2.56,1.7A0.6,0.6 0 0 1 5,21.2V3a1,1 0 0 1 1,-1z" />
    <!-- Ruled lines, punched back out at lower alpha. -->
    <path
        android:fillColor="#66000000"
        android:pathData="M9,7.5h6v1.6h-6z M9,11h6v1.6h-6z" />
</vector>
