<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Keep the native launch window lightweight. Android 12+ already uses the
      platform splash icon, while Flutter shows the branded startup poster only
      if database bootstrap is still pending after the first frame.
    -->
    <item android:drawable="@color/launch_background" />
</layer-list>
